#[allow(unused)]
fn main() {
    let (__dial9_recorder, __dial9_rt) = my_config()
        .expect("dial9::main: config failed");
    let __dial9_out = ::dial9::block_on(
        &__dial9_rt,
        async move {
            let _ = 42;
        },
    );
    drop(__dial9_rt);
    __dial9_recorder.graceful_shutdown(::std::time::Duration::from_secs(1));
    __dial9_out
}
