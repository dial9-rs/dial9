# No trailing slash: `node_modules/` matches only a directory, so a symlinked
# node_modules (as worktrees often use) slipped past it and got committed.
node_modules
dist/*
!dist/.gitkeep
# live-check reports (generated)
live-checks/out/
# regenerable fixture seed tree (incl. the >200 MB large family) — only the
# small fixtures under live-checks/fixtures/segments/ are committed (size policy:
# ui/README.md "Live UI checks")
live-checks/fixtures/generated/
